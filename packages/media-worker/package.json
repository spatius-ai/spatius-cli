{
  "name": "@spatius/media-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --env production --outdir dist",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@spatius/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.8",
    "vitest": "~4.1.0",
    "wrangler": "4.131.1"
  }
}
